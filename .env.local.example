# URL da API de rastreamento (deixe vazio em dev para desativar)
# Local:      http://localhost:4000/api/v1/events
# Produção:   https://SEU-DOMINIO-DA-API/api/v1/events
NEXT_PUBLIC_TRACK_URL=

# Formulário (Formspree)
# (já embutido em lib/contact.js)

# Verificação do Google Search Console (opcional).
# Cole aqui SÓ o valor do content da meta tag "google-site-verification".
# Ex.: se o Google der <meta name="google-site-verification" content="ABC123" />,
# então: NEXT_PUBLIC_GSC_VERIFICATION=ABC123
NEXT_PUBLIC_GSC_VERIFICATION=
